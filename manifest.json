{
  "manifest_version": 3,
  "name": "QuickActions for Proxmox Virtual Environment",
  "version": "0.2.5",
  "description": "Quick-Actions flyout for Proxmox VE guests — status overview, power controls, snapshots, backups",
  "browser_specific_settings": {
    "gecko": {
      "id": "proxmox-quickactions@andiatom.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickActions for Proxmox VE",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
